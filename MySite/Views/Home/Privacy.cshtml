@model List<MySite.Models.Service>

@{
    ViewData["Title"] = "Наши услуги";
}

@section Styles {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="services-section">
        <div class="text-center mb-5">
            <h1 class="services-title">Наши услуги</h1>
            <p class="lead theme-text mt-3">Мы предлагаем полный спектр IT-решений для вашего бизнеса.</p>
        </div>

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="theme-card h-100 d-flex flex-column">
                        <img src="@item.ImagePath" class="card-img-top mb-3" alt="@item.Title" style="border-radius: 8px; height: 200px; object-fit: cover;">
                        <h5 class="fw-bold" style="color: #00695c;">@item.Title</h5>
                        <p class="theme-text flex-grow-1">@item.Description</p>
                        <a href="#" class="btn-theme mt-auto text-center">Узнать цену</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>