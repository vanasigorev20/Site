@{
    ViewData["Title"] = "Главная страница";
}

<!-- Баннер -->
<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">Добро пожаловать в MySite</h1>
        <p class="col-md-8 fs-4">Мы создаем цифровые продукты, которые приносят прибыль. Разработка сайтов, приложений и продвижение под ключ.</p>
        <a asp-controller="Home" asp-action="Privacy" class="btn btn-primary btn-lg">Наши услуги</a>
    </div>
</div>

<!-- О нас (Цифры) -->
<div class="row text-center mb-5">
    <div class="col-md-4">
        <h2 class="text-primary">10+</h2>
        <p>Лет на рынке</p>
    </div>
    <div class="col-md-4">
        <h2 class="text-primary">250+</h2>
        <p>Довольных клиентов</p>
    </div>
    <div class="col-md-4">
        <h2 class="text-primary">500+</h2>
        <p>Реализованных проектов</p>
    </div>
</div>

<!-- Наши преимущества (3 колонки) -->
<h2 class="text-center mb-4">Почему выбирают нас</h2>
<div class="row mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body text-center">
                <h5 class="card-title">Опытная команда</h5>
                <p class="card-text">Наши специалисты имеют опыт работы более 5 лет в сфере IT.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body text-center">
                <h5 class="card-title">Соблюдение сроков</h5>
                <p class="card-text">Мы ценим ваше время и всегда сдаем проекты точно в срок.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body text-center">
                <h5 class="card-title">Поддержка 24/7</h5>
                <p class="card-text">Вы всегда можете связаться с нами и получить помощь.</p>
            </div>
        </div>
    </div>
</div>