@model IEnumerable<MySite.Models.Book>

@{
    ViewData["Title"] = "Список книг";
}

<div class="container mt-4">
    <h1>Каталог книг</h1>
    <p>Данные загружены напрямую из базы данных SQL Server через ADO.NET.</p>

    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Название</th>
                <th>Автор</th>
                <th>Год</th>
                <th>Цена</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Year</td>
                    <td>@book.Price</td>
                </tr>
            }
        </tbody>
    </table>
</div>